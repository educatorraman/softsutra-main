# Optional: override the detected parent domain at build time (no protocol prefix).
VITE_ROOT_DOMAIN=

# Paste the live Google AdSense publisher ID here when the account is approved.
# Format: ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_PUB_ID=

# Optional per-placement ad unit IDs. Leave empty to keep reserved fallback geometry.
VITE_AD_SLOT_LEADERBOARD=
VITE_AD_SLOT_INARTICLE=
VITE_AD_SLOT_SIDEBAR=
VITE_AD_SLOT_MOBILE=
